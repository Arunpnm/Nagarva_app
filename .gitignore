# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Firebase – this is necessary if you use Firebase since it could otherwise 
# lead to leaking of private certificates to your repository, which is no bueno.
.firebase/

# Web related

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
*.bat

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Local admin/ops scripts and their output (19 Aug 2026).
# These have held live admin tokens and account passwords — *.bat is
# already ignored above; this keeps the rule explicit and adds the
# result payloads, which echo back API responses.
*.bat
delete_test1_result.json
*_result.json

# Local environment / key material. Never commit.
.env
.env.*
!.env.example
*.pem
*.p12
*.keystore
*.jks
android/key.properties
service_role*.txt

# Sibling of the ignored *.bat admin scripts — same live credentials,
# different extension. Caught 19 Aug 2026 only because *.bat missed it.
*.ps1
!scripts/*.ps1

# Supabase CLI local state (project ref, pooler connection string).
supabase/.temp/

sentry.properties

# Scratch screenshots/uiautomator dumps from an on-device Claude Code QA
# pass (26 Aug 2026) — hundreds of throwaway PNGs/XML, no lasting value.
device_pass_screens/

# gen_l10n output (NG-055). Generated from lib/l10n/*.arb by
# `flutter pub get` per l10n.yaml — five files that churn on every ARB
# edit. A fresh clone must run `flutter pub get` before it will compile.
lib/l10n/gen/

# Tooling binaries. sentry-wizard.exe is 86MB and, more importantly,
# MUST NOT BE RUN on this repo: it patches main.dart and pubspec.yaml to
# inject its own Sentry.init, which would overwrite the redaction layer
# in lib/backend/crash_reporting.dart. The integration is already wired
# by hand and tested (test/crash_redaction_test.dart); the DSN arrives
# via --dart-define, not via the wizard.
*.exe

# Machine-specific: contains absolute paths. Copy .claude/launch.example.json and edit.
.claude/launch.json
